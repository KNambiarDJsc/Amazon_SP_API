# Copy to .env. Never commit real values.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eligibility
REDIS_URL=redis://localhost:6379/0

# "mock" serves offline fixtures and flags every job as DEMO data. "live" calls SP-API
# (not available until Phase 3; the API answers 503 rather than fall back to fixtures).
AMAZON_MODE=mock
MARKETPLACE_ID=A21TJRUUN4KGV

# Single-machine mode: run the scheduler and worker inside the API process (no Redis queue).
# Pair it with RATE_LIMITER=memory and, for a quick local run, a SQLite DATABASE_URL.
INLINE_WORKER=false
# "redis" shares each seller's rate budget across worker processes; "memory" is single-process.
RATE_LIMITER=redis

# SP-API usage plans differ per operation and seller. Verify the account's plan before raising.
RATE_SEARCH_CATALOG_PER_SEC=2.0
RATE_SEARCH_CATALOG_BURST=2
RATE_RESTRICTIONS_PER_SEC=5.0
RATE_RESTRICTIONS_BURST=10

# Execution
SELLER_MAX_CONCURRENT_BRANDS=2
MAX_BRAND_ATTEMPTS=5
BRAND_LEASE_SECONDS=300
QUEUE_LEASE_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=2.0

# Input limits
MAX_UPLOAD_BYTES=5242880
MAX_BRANDS_PER_JOB=5000
