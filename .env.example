# Copy to .env. Never commit real values.
# Used by docker compose (as interpolation) and, for the settings that match, by local development.

# ======================= docker compose deployment (docs/DEPLOY.md) ============================
# REQUIRED. Use long random values:  head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9'
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Hostname for automatic HTTPS (DNS must point here; ports 80 and 443 must be reachable),
# or ":80" for plain HTTP behind another TLS terminator / on a private network.
SITE_ADDRESS=localhost
# Host headers the API accepts. Set to your domain (comma-separated). Keep 127.0.0.1 and api.
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Workers: processes x threads. More does NOT go faster: SP-API rate limits are the ceiling.
WORKER_PROCESSES=2
WORKER_THREADS=4

# Required to scrape /metrics (docker compose --profile monitoring); also protects /metrics.
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=change-me

# ======================= application settings ==================================================
# "mock" serves offline fixtures and flags every job and export as DEMO data. "live" calls SP-API.
AMAZON_MODE=mock
MARKETPLACE_ID=A21TJRUUN4KGV

# --- Live mode (AMAZON_MODE=live). India is served by the EU endpoint.
# python -m app.cli generate-encryption-key   -> value for CREDENTIAL_ENCRYPTION_KEYS (newest key first;
# keep old keys listed, comma-separated, until every credential has been re-saved).
# BACK THIS UP SEPARATELY from the database: without it stored refresh tokens cannot be decrypted.
CREDENTIAL_ENCRYPTION_KEYS=
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
# Only for the public / multi-seller website authorisation flow:
SP_API_APPLICATION_ID=
OAUTH_REDIRECT_URI=https://your-host.example/api/v1/amazon/callback
SP_API_DRAFT_APP=false
# SP_API_BASE_URL=https://sellingpartnerapi-eu.amazon.com   (sandbox: https://sandbox.sellingpartnerapi-eu.amazon.com)
# SELLER_CENTRAL_URL=https://sellercentral.amazon.in

# SP-API usage plans differ per operation and seller. Verify before raising these.
RATE_SEARCH_CATALOG_PER_SEC=2
RATE_SEARCH_CATALOG_BURST=2
RATE_RESTRICTIONS_PER_SEC=5
RATE_RESTRICTIONS_BURST=10

# In-flight brand tasks per seller across all of their jobs (fairness + browser-session safety).
SELLER_MAX_CONCURRENT_BRANDS=2

# Retry bounds (see docs/ARCHITECTURE.md, failure taxonomy).
MAX_BRAND_ATTEMPTS=5
MAX_CHECK_ATTEMPTS=3
MAX_THROTTLE_DEFERRALS=30
BRAND_LEASE_SECONDS=300

# Upload and report limits. Jobs above EXPORT_SYNC_MAX_CHECKS build their report in the background.
MAX_UPLOAD_BYTES=5242880
MAX_BRANDS_PER_JOB=5000
EXPORT_SYNC_MAX_CHECKS=10000

# --- Optional browser verification: OFF by default. Read docs/BROWSER_VERIFICATION.md first.
# Needs an image built with WITH_BROWSER=1 (see docs/DEPLOY.md).
BROWSER_AUTOMATION_ENABLED=false
# Required to enable: email or URL of whoever operates the agent (sent in the User-Agent).
BROWSER_AGENT_CONTACT=
# BROWSER_EXECUTABLE_PATH=        # use an installed Chromium instead of Playwright's
# BROWSER_LISTING_URL=https://sellercentral.amazon.in/product-search   # calibrate to your account
BROWSER_MIN_INTERVAL_SECONDS=4
BROWSER_SCREENSHOTS=true

# Optional OpenTelemetry tracing (build with BACKEND_EXTRAS=telemetry).
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ======================= local development (no docker) =========================================
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eligibility
# REDIS_URL=redis://localhost:6379/0
# EVIDENCE_DIR=var/evidence
# EXPORT_DIR=var/exports
