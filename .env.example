# Copy to .env. Never commit real values.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eligibility
REDIS_URL=redis://localhost:6379/0

# "mock" serves offline fixtures and flags every job as DEMO data. "live" calls SP-API for each
# seller's own account and refuses to run (never falls back to fixtures) until configured.
AMAZON_MODE=mock
MARKETPLACE_ID=A21TJRUUN4KGV

# ---- live SP-API ----
# From the app's LWA credentials in Seller Central > Apps and Services > Develop Apps.
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
# Encrypts stored refresh tokens. Generate with: python -m app.cli generate-key
# Rotation: put the new key first (NEW,OLD), run `python -m app.cli rotate-credentials`, drop OLD.
CREDENTIALS_ENCRYPTION_KEYS=
# Amazon India is served by the Europe endpoint.
SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
# Reasons are classified by their English wording; keep this an English locale.
SPAPI_LOCALE=en_IN
SPAPI_TIMEOUT_SECONDS=20

# Seller Central consent page (website workflow). Not needed when a private app's refresh
# token is registered with `python -m app.cli connect-seller`.
SPAPI_APPLICATION_ID=
# Must exactly match a redirect URI registered on the app; points at this API's callback.
SPAPI_REDIRECT_URI=https://eligibility.example.com/api/v1/amazon/callback
# Draft (unpublished) apps need version=beta on the consent URL.
SPAPI_APP_IS_DRAFT=false
SELLER_CENTRAL_URL=https://sellercentral.amazon.in

# Single-machine mode: run the scheduler and worker inside the API process (no Redis queue).
# Pair it with RATE_LIMITER=memory and, for a quick local run, a SQLite DATABASE_URL.
INLINE_WORKER=false
# "redis" shares each seller's rate budget across worker processes; "memory" is single-process.
RATE_LIMITER=redis

# Documented usage plans per seller and app: searchCatalogItems 2 rps (burst 2),
# getListingsRestrictions 5 rps (burst 10). Amazon can lower them; never set these higher.
RATE_SEARCH_CATALOG_PER_SEC=2.0
RATE_SEARCH_CATALOG_BURST=2
RATE_RESTRICTIONS_PER_SEC=5.0
RATE_RESTRICTIONS_BURST=10

# Execution
SELLER_MAX_CONCURRENT_BRANDS=2
MAX_BRAND_ATTEMPTS=5
BRAND_LEASE_SECONDS=300
QUEUE_LEASE_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=2.0

# Input limits
MAX_UPLOAD_BYTES=5242880
MAX_BRANDS_PER_JOB=5000
